    {
      "name": "4. Payments & Search Specifications (Thorn Chhuntheang)",
      "item": [
        {
          "name": "4.1 Multi-Param Payment Search & Filter",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/search?status=CONFIRMED&page=0&size=10&sortBy=paymentDate&sortDir=desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "search"],
              "query": [
                { "key": "status", "value": "CONFIRMED" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "sortBy", "value": "paymentDate" },
                { "key": "sortDir", "value": "desc" }
              ]
            }
          }
        },
