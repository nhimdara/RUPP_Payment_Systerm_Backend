    },
    {
      "name": "4. QA & Validation Tests (Your Deliverable)",
      "item": [
        {
          "name": "4.1 Validation Test: Blank Login Inputs (Expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400 Bad Request', function() { pm.response.to.have.status(400); });",
                  "var res = pm.response.json();",
                  "pm.test('Validation failed message present', function() {",
                  "    pm.expect(res.success).to.eql(false);",
                  "    pm.expect(res.message).to.eql('Validation failed');",
                  "    pm.expect(res.data.usernameOrEmail).to.not.be.empty;",
                  "    pm.expect(res.data.password).to.not.be.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"\",\n  \"password\": \"\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
          }
        },
        {
          "name": "4.2 Validation Test: Invalid Email Format (Expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400 Bad Request', function() { pm.response.to.have.status(400); });",
                  "var res = pm.response.json();",
                  "pm.test('Email validation error present', function() {",
                  "    pm.expect(res.data.email).to.not.be.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"test_invalid_email\",\n  \"email\": \"not-an-email-format\",\n  \"password\": \"pass123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "register"] }
          }
        },
        {
          "name": "4.3 Security Test: Wrong Password (Expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401 Unauthorized', function() { pm.response.to.have.status(401); });",
                  "var res = pm.response.json();",
                  "pm.test('Bad credentials error', function() {",
                  "    pm.expect(res.success).to.eql(false);",
                  "    pm.expect(res.message).to.include('Invalid username/email or password');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"admin\",\n  \"password\": \"WRONG_PASSWORD_XYZ\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
          }
        },
        {
          "name": "4.4 RBAC Test: Student accessing Admin Users (Expect 403 Forbidden)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 403 Forbidden', function() { pm.response.to.have.status(403); });",
                  "var res = pm.response.json();",
                  "pm.test('Access denied message present', function() {",
                  "    pm.expect(res.error || res.message).to.be.oneOf(['Forbidden', 'Access denied']);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{student_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/users", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users"] }
          }
        },
        {
          "name": "4.5 Exception Test: Get Non-Existent Student ID (Expect 404 Not Found)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404 Not Found', function() { pm.response.to.have.status(404); });",
                  "var res = pm.response.json();",
                  "pm.test('Resource not found message', function() {",
                  "    pm.expect(res.success).to.eql(false);",
                  "    pm.expect(res.message).to.include('not found');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/students/99999", "host": ["{{baseUrl}}"], "path": ["api", "v1", "students", "99999"] }
          }
        }
      ]
    }
  ]
}
