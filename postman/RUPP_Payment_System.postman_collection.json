{
  "info": {
    "_postman_id": "rupp-payment-system-collection",
    "name": "RUPP Payment System API Suite",
    "description": "Comprehensive QA Test Suite for RUPP Payment System. Author: Tab Ayutaya (@boayuthaya)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "1.1 Login - Admin (Auto Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function() { pm.response.to.have.status(200); });",
                  "var res = pm.response.json();",
                  "pm.test('Login Success', function() { pm.expect(res.success).to.eql(true); });",
                  "pm.test('Save JWT Token to Environment', function() {",
                  "    pm.expect(res.data.accessToken).to.be.a('string');",
                  "    pm.environment.set('jwt_token', res.data.accessToken);",
                  "    pm.environment.set('refresh_token', res.data.refreshToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
          }
        },
        {
          "name": "1.2 Login - Student (Tab Ayutaya)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function() { pm.response.to.have.status(200); });",
                  "var res = pm.response.json();",
                  "pm.test('Student Login Success', function() { pm.expect(res.success).to.eql(true); });",
                  "pm.environment.set('student_token', res.data.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"{{student_username}}\",\n  \"password\": \"{{student_password}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
          }
        },
        {
          "name": "1.3 Get Current User Profile (/me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function() { pm.response.to.have.status(200); });",
                  "var res = pm.response.json();",
                  "pm.test('Fetched Authenticated User', function() { pm.expect(res.data.username).to.not.be.empty; });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "me"] }
          }
        },
        {
          "name": "1.4 Register New Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created or 409 Conflict', function() {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"new_student_test\",\n  \"email\": \"new_test@rupp.edu.kh\",\n  \"password\": \"password123\",\n  \"role\": \"ROLE_STUDENT\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"Student\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "register"] }
          }
        }
      ]
    },
    {
      "name": "2. User Management (Admin)",
      "item": [
        {
          "name": "2.1 Get All Users (Admin Auth)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function() { pm.response.to.have.status(200); });",
                  "var res = pm.response.json();",
                  "pm.test('User list returned', function() { pm.expect(res.data.length).to.be.above(0); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/users", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users"] }
          }
        },
        {
          "name": "2.2 Get User By ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function() { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/users/1", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users", "1"] }
          }
        }
      ]
    },
    {
      "name": "3. Student Management",
      "item": [
        {
          "name": "3.1 Get All Students",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function() { pm.response.to.have.status(200); });",
                  "var res = pm.response.json();",
                  "pm.test('Students list contains 6 group members', function() { pm.expect(res.data.length).to.be.above(0); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/students", "host": ["{{baseUrl}}"], "path": ["api", "v1", "students"] }
          }
        },
        {
          "name": "3.2 Get My Student Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function() { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{student_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/students/my-profile", "host": ["{{baseUrl}}"], "path": ["api", "v1", "students", "my-profile"] }
